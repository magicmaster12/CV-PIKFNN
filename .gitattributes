# 统一换行符：文本按各文件原样入库，检出时由 git 自动处理
* text=auto

# ---- 源码与文档：强制 LF，避免 Windows/Linux 之间 diff 抖动 ----
*.py    text eol=lf
*.ipynb text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf

# ---- 二进制：不做换行转换、不做 diff ----
*.png   binary
*.jpg   binary
*.jpeg  binary
*.tiff  binary
*.gif   binary
*.pdf   binary
*.npz   binary
*.npy   binary
*.pt    binary
*.pth   binary
*.vtu   binary
*.vtp   binary
*.vtk   binary

# ---- GitHub 语言统计：notebook 与结果表不计入主语言，突出 Python 代码 ----
*.ipynb linguist-documentation=false
*.csv   linguist-generated=true
*.txt   linguist-generated=true

# ---- 大文件不要走 Git LFS（本仓库最大单文件 < 30 MB，纯 git 即可）----
